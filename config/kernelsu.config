# EXPERIMENTAL built-in KernelSU integration for android12-5.10.
# Upstream KernelSU >=3.0 recommends LKM and no longer supports GKI image mode.
# Compilation is not evidence that root or device boot has been validated.
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_KRETPROBES=y
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_HAVE_SYSCALL_TRACEPOINTS=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY_SELINUX=y
